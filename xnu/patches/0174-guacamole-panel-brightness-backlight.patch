+/*
+ * 0174: panel brightness. The boot loader leaves a DSI long-write packet (header 0xc0390003, payload 51 hh ll)
+ * at DMA_BASE; rewriting its payload and firing the DMA SW trigger (0x90) sets the Samsung panel's brightness
+ * (0173 showed it dim and brighten the screen). Level 0..0x3ff (0x12c at boot). Returns 0 or an errno.
+ */
+static vm_offset_t bl_dsi, bl_buf;
+static uint32_t bl_off;
+static int bl_state;                    /* 0 not tried, 1 ready, -1 unusable */
+static volatile int bl_busy;
+
+int
+sweet_dsi_set_level(uint32_t level)
+{
+	if (bl_state < 0) {
+		return ENXIO;
+	}
+	if (!__sync_bool_compare_and_swap(&bl_busy, 0, 1)) {
+		return EBUSY;
+	}
+	int ret = 0;
+	if (bl_state == 0) {
+		bl_dsi = ml_io_map(DSI0_PA, DSI_SIZE);
+		uint32_t base = bl_dsi ? rd(bl_dsi, 0x48) : 0;
+		bl_buf = base ? ml_io_map(base & ~0xfffu, 0x1000) : 0;
+		bl_off = base & 0xfffu;
+		if (!bl_dsi || !bl_buf || rd(bl_dsi, 0x4c) != 8 || rd(bl_buf, bl_off) != 0xc0390003u ||
+		    (rd(bl_buf, bl_off + 4) & 0xffu) != 0x51u) {
+			printf("SWEET DSI: brightness packet not found (base %#x), brightness control off\n", base);
+			bl_state = -1;
+			ret = ENXIO;
+			goto out;
+		}
+		printf("SWEET DSI: brightness packet at %#x, control on\n", base);
+		bl_state = 1;
+	}
+	if (level > 0x3ffu) {
+		level = 0x3ffu;
+	}
+	wr(bl_buf, bl_off + 4, 0x89000051u | ((level >> 8) << 8) | ((level & 0xffu) << 16));
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr(bl_dsi, 0x90, 1);
+	delay(2000);
+out:
+	bl_busy = 0;
+	return ret;
+}
