+/*
+ * 0174: panel brightness. CoreBrightness/SpringBoard look for a service with backlight-control (AppleARMBacklight
+ * on an iPhone) and send brightness as properties (IOMFBBrightnessLevel, in nits as 16.16 fixed point, on the
+ * framebuffer or the backlight service); the DSI DMA (sweet_dsi_set_level) turns the level into the panel's DCS
+ * 0x51. Every key a client sets is logged once per value (the first 40), to see which one the slider uses.
+ * Boot-arg sweetbl=0 turns it off.
+ */
+#define SWEET_BL_MAX_NITS   420u
+#define SWEET_BL_MIN_LEVEL  0x10u
+#define SWEET_BL_MAX_LEVEL  0x3ffu
+
+static void
+sweet_bl_set(const char *who, const char *key, OSObject *val)
+{
+	static uint32_t logged;
+	OSNumber *num = OSDynamicCast(OSNumber, val);
+	uint64_t raw = num ? num->unsigned64BitValue() : 0;
+	if (logged < 40) {
+		logged++;
+		IOLog("SWEET BL: %s sets %s = %s %llu (%#llx)\n", who, key, num ? "number" : (val ? val->getMetaClass()->getClassName() : "null"),
+		    raw, raw);
+	}
+	if (!num || !(strcmp(key, "IOMFBBrightnessLevel") == 0 || strcmp(key, "brightness-nits") == 0 ||
+	    strcmp(key, "IOBacklightBrightness") == 0 || strcmp(key, "brightness") == 0)) {
+		return;
+	}
+	/* nits in 16.16 fixed point (anything above 0x10000 per nit-scale), else plain nits */
+	uint64_t nits = raw >= 0x10000ull ? raw >> 16 : raw;
+	if (nits > SWEET_BL_MAX_NITS) {
+		nits = SWEET_BL_MAX_NITS;
+	}
+	uint32_t level = SWEET_BL_MIN_LEVEL + (uint32_t)((nits * (SWEET_BL_MAX_LEVEL - SWEET_BL_MIN_LEVEL)) / SWEET_BL_MAX_NITS);
+	int err = sweet_dsi_set_level(level);
+	IOLog("SWEET BL: %s %s %llu nits -> level %#x: %d\n", who, key, nits, level, err);
+}
+
+static IOReturn
+sweet_bl_props(const char *who, OSObject *properties)
+{
+	OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+	if (dict == NULL) {
+		return kIOReturnSuccess;
+	}
+	OSCollectionIterator *it = OSCollectionIterator::withCollection(dict);
+	if (it == NULL) {
+		return kIOReturnSuccess;
+	}
+	while (OSObject *k = it->getNextObject()) {
+		OSSymbol *sym = OSDynamicCast(OSSymbol, k);
+		OSString *str = OSDynamicCast(OSString, k);
+		const char *key = sym ? sym->getCStringNoCopy() : (str ? str->getCStringNoCopy() : NULL);
+		if (key) {
+			sweet_bl_set(who, key, dict->getObject(key));
+		}
+	}
+	it->release();
+	return kIOReturnSuccess;
+}
+
+class AppleARMBacklight : public IOService {
+	OSDeclareDefaultStructors(AppleARMBacklight);
+public:
+	using IOService::setProperty;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE
+	{
+		return sweet_bl_props("AppleARMBacklight", properties);
+	}
+	bool setProperty(const char *aKey, OSObject *anObject) APPLE_KEXT_OVERRIDE
+	{
+		sweet_bl_set("AppleARMBacklight(setProperty)", aKey, anObject);
+		return IOService::setProperty(aKey, anObject);
+	}
+};
+
+OSDefineMetaClassAndStructors(AppleARMBacklight, IOService);
