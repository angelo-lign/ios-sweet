-	unsigned errors = 0, ticks = 0;
+	unsigned errors = 0, ticks = 0, polls = 0, bad = 0, hid0 = st.hid;
+	const unsigned stat_every = 5000u / poll_ms;      /* 0168: one statistics line every 5 s */
 	while (!st.dead) {
+		if (st.resume) {
+			st.resume = false;
+			touch_reinit("display on");
+			errors = 0;
+		}
 		/* Optional IRQ hint (active low) still reads every ~100 ms and while down. */
 		if (!st.irq_hint || st.active || !(touch_rd(st.gpio, TOUCH_GPIO_IO(TP_IRQ)) & 1u) ||
 		    (++ticks % (100u / poll_ms)) == 0) {
 			int err = touch_s6sy();
+			polls++;
 			if (err) {
+				bad++;
 				if ((errors++ % 100u) == 0) {
 					printf("SWEET TOUCH: report err=%d irq=%#x\n", err, st.irq_status);
 				}
 				if (errors == 10) {
 					touch_report(0, st.x, st.y); /* release after persistent bad reads */
 				}
+				if (errors == 25 || (errors > 25 && ((errors - 25) % 500u) == 0)) {
+					touch_reinit("bus errors");     /* 0168: the IC is not answering: start it again */
+				}
 			} else {
 				errors = 0;
 			}
 		}
+		if (polls >= stat_every) {
+			printf("SWEET TOUCH: 5s: polls=%u errors=%u hid=%u irq-pin=%u sda=%u scl=%u\n",
+			    polls, bad, st.hid - hid0, touch_rd(st.gpio, TOUCH_GPIO_IO(TP_IRQ)) & 1u,
+			    bb_level(0) ? 1u : 0u, bb_level(1) ? 1u : 0u);
+			polls = bad = 0;
+			hid0 = st.hid;
+		}
 		touch_wait(poll_ms);
 	}
 	touch_report(0, st.x, st.y);
