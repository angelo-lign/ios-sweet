+/*
+ * 0168: bring the IC back to its running state: release every finger, free the bus, pulse reset, then the
+ * same TOUCH_FUNCTION / SENSE_ON the first start sends (Linux s6sy761 does this on every resume). Called on
+ * the touch thread when the display comes on, and when the bus keeps failing.
+ */
+static void
+touch_reinit(const char *why)
+{
+	uint8_t bs = 0;
+	touch_report(0, st.x, st.y);
+	if (st.bitbang) {
+		bb_recover();
+	}
+	touch_gpio(TP_RST, 0, 0, 3, true, false);     /* low = reset */
+	touch_wait(10);
+	touch_gpio(TP_RST, 0, 0, 3, true, true);      /* out of reset */
+	touch_wait(300);                              /* as the first start: Linux waits 140 ms */
+	int e1 = touch_read(TP_ADDR, SY_BOOT_STATUS, false, &bs, 1);
+	const uint8_t func[3] = {SY_TOUCH_FUNC, 0x01, 0x00};
+	const uint8_t on = SY_SENSE_ON;
+	const uint8_t clr = SY_CLEAR_STACK;
+	int w1 = touch_write(func, sizeof(func));
+	int w2 = touch_write(&on, 1);
+	(void)touch_write(&clr, 1);
+	printf("SWEET TOUCH: re-init (%s): boot-status err=%d bs=%#x (app=0x20) touch-function=%d sense-on=%d\n",
+	    why, e1, bs, w1, w2);
+}
+
+/* 0168: called by the framebuffer driver when the display turns off or on (RequestPowerChange). */
+void
+sweet_touch_display(bool on)
+{
+	printf("SWEET TOUCH: display %s\n", on ? "on" : "off");
+	if (on) {
+		st.resume = true;
+	}
+}
