+
+/*
+ * 0177: boot-arg sweetbllevel=N (0x10..0x3ff; 0x12c is the boot loader's) sets the panel brightness through
+ * sweet_dsi_set_level() sweetbldelay seconds (default 75) after boot, three times 5 s apart (the first may find
+ * the DMA busy). Dimmer = cooler and less battery on this AMOLED.
+ */
+static void
+bl_level_thread(void *arg, wait_result_t result)
+{
+	unsigned level = 0, delay_s = 75;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("sweetbllevel", &level, sizeof(level));
+	(void)PE_parse_boot_argn("sweetbldelay", &delay_s, sizeof(delay_s));
+	gpu_wait_ms(delay_s * 1000u);
+	for (unsigned i = 0; i < 3; i++) {
+		int err = sweet_dsi_set_level(level);
+		printf("SWEET DSI: brightness level %#x: %d\n", level, err);
+		gpu_wait_ms(5000);
+	}
+	thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
 }
 
