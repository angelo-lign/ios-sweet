diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -2719,7 +2719,37 @@
 			}
 		}
 	}
-	printf("SWEET DSI: probe done (nothing written)\n");
+	/*
+	 * sweetdsi=3: resend the boot loader's own brightness packet (header 0xc0390003 = DCS long write, WC 3,
+	 * payload 51 hh ll, 8 bytes at DMA_BASE) with other levels: dim, bright, back to the boot value.
+	 * DMA_BASE/LEN already point at it, so only the payload word changes, then the DMA SW trigger (0x90, which
+	 * the boot loader left at 1) fires it. Levels after boot: 0x50, 0x3ff, then the original.
+	 */
+	{
+		unsigned level = 0;
+		(void)PE_parse_boot_argn("sweetdsi", &level, sizeof(level));
+		if (level >= 3) {
+			uint32_t base = rd(d0, 0x48);
+			vm_offset_t buf = ml_io_map(base & ~0xfffu, 0x1000);
+			uint32_t o = base & 0xfffu;
+			if (!buf || rd(d0, 0x4c) != 8 || rd(buf, o) != 0xc0390003u) {
+				printf("SWEET DSI: DMA buffer is not the expected brightness packet, not sending\n");
+			} else {
+				uint32_t orig = rd(buf, o + 4);
+				uint32_t levels[3] = { 0x0050, 0x03ff, (((orig >> 8) & 0xffu) << 8) | ((orig >> 16) & 0xffu) };
+				for (unsigned i = 0; i < 3; i++) {
+					uint32_t v = levels[i];
+					wr(buf, o + 4, (orig & 0xff0000ffu & ~0xff0000u) | ((v >> 8) << 8) | ((v & 0xffu) << 16));
+					__asm__ volatile ("dsb sy" ::: "memory");
+					wr(d0, 0x90, 1);
+					gpu_wait_ms(50);
+					printf("SWEET DSI: level %#x sent: INT_CTRL %#x STATUS %#x FIFO %#x\n", v, rd(d0, 0x110), rd(d0, 8), rd(d0, 0xc));
+					gpu_wait_ms(5000);
+				}
+			}
+		}
+	}
+	printf("SWEET DSI: probe done\n");
 out:
 	thread_terminate(current_thread());
 	thread_block(THREAD_CONTINUE_NULL);
