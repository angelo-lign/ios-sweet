+					{ 0xc0390003u, 0x89000051u | ((0x03ffu >> 8) << 8) | ((0x03ffu & 0xffu) << 16), "brightness 0x3ff", 4000 },
+					{ 0xc0390003u, 0x89000051u | ((restore >> 8) << 8) | ((restore & 0xffu) << 16), "brightness original", 1000 },
